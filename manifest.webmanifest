{
  "name": "Our Recipe Box",
  "short_name": "Recipe Box",
  "description": "The recipes we keep coming back to.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f9f1e5",
  "theme_color": "#f9f1e5",
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
